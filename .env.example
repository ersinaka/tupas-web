# Public canonical URL (no trailing slash). Used for canonical, hreflang, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.tupas.com.tr

# Resend (https://resend.com) – quote / contact form delivery.
# Without RESEND_API_KEY the form logs submissions to the server console in development
# and returns an error in production.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Tüpaş Web <form@tupas.com.tr>"
QUOTE_FROM_EMAIL=
# Comma-separated list of recipients for incoming requests
QUOTE_TO_EMAIL=
